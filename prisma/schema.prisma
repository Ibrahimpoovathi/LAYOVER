generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// LAYOVER — data model
// Traveler → Trips → Missions (→ Stamps)
// Every adventure generated tonight lands here.
// The "wall of adventures" at the booth reads from this.
// ─────────────────────────────────────────────

model Traveler {
  id        String   @id @default(cuid())
  nickname  String   @unique
  pinHash   String? // crew login: sha256 of the 4-digit crew PIN (null = unclaimed)
  trips     Trip[]
  reviews   Review[]
  createdAt DateTime @default(now())
}

model Trip {
  id              String    @id @default(cuid())
  travelerId      String?
  traveler        Traveler? @relation(fields: [travelerId], references: [id], onDelete: SetNull)
  iata            String
  city            String
  country         String
  mode            String    @default("air") // "air" (WINGS) | "road" (WHEELS)
  vehicle         String?   // WHEELS only: "bus" | "train"
  destination     String?   // WHEELS journey: "Bengaluru" (city of arrival)
  routeCode       String?   // "NH-766" / "COASTAL LINE" ticket flavor
  durationMin     Int
  vibe            String
  adventureTitle  String
  funFact         String?
  bufferMin       Int       @default(60)
  source          String    @default("ai") // "ai" | "demo"
  accessProfile   String    @default("none") // "none" | "wchr" | "dpna" | "deaf" (IATA SSR)
  createdAt       DateTime  @default(now())
  missions        Mission[]
  stamps          Stamp[]

  @@index([createdAt])
  @@index([iata])
}

model Mission {
  id          String  @id @default(cuid())
  tripId      String
  trip        Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  description String
  durationMin Int
  category    String // eat | explore | chill | move | weird | rest
  location    String
  tip         String?
  done        Boolean @default(false)
  distanceM   Int?    // EVERY BODY BOARDS: roll/walk distance from previous point
  stepFree    Boolean? // elevator/ramp/level route exists
  sensory     String? // "quiet" | "moderate" | "loud"
  stamp       Stamp?

  @@index([tripId])
}

model Stamp {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  missionId String?  @unique
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  category  String
  ink       String   @default("#c2452d")
  earnedAt  DateTime @default(now())

  @@index([tripId])
}

// ─────────────────────────────────────────────
// CREW REVIEWS — "is this task worth it?"
// One review per crew member per task. Tasks are grouped by
// missionKey (title|location, normalized) so reviews aggregate
// across every trip that generated the same task — not just one
// trip's copy of it. Reading is public; writing requires login.
// ─────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  missionKey String // normalized "title|location" — the task identity
  missionId  String? // back-reference to the mission instance reviewed (null = keyed only)
  travelerId String
  traveler   Traveler @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  nickname   String // denormalized for fast rendering
  rating     Int // 1..5 stars
  verdict    String? // WORTH_IT | PRICEY | SKIP
  comment    String? // optional short field note (cost / value / tip)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([travelerId, missionKey]) // one review per crew per task (upsert = update)
  @@index([missionKey])
}
